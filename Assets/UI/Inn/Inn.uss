/* Inn UI 스타일 — App UI 테마 위에 ARPG 스킨 */

.inn-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.inn-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
}

.inn-panel {
    width: 480px;
    padding: 24px;
    border-radius: 12px;
    background-color: rgba(28, 28, 32, 0.96);
    border-width: 1px;
    border-color: rgba(180, 140, 80, 0.4);
}

.inn-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.inn-title {
    color: rgb(220, 180, 100);
}

.inn-close-icon {
    --appui-iconbutton-size: 32px;
}

.inn-body {
    flex-direction: column;
    padding-top: 16px;
    padding-bottom: 16px;
}

.inn-status {
    margin-bottom: 8px;
    color: rgb(220, 220, 220);
}

.inn-cost {
    color: rgb(255, 215, 100);
}

.inn-buttons {
    flex-direction: column;
    padding-top: 16px;
}

.inn-btn {
    margin-bottom: 8px;
}

.inn-btn:disabled {
    opacity: 0.4;
}
