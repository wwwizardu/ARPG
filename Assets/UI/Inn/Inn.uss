/* Inn UI 스타일 — App UI 테마 위에 ARPG 스킨 */

.inn-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.inn-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
}

.inn-panel {
    width: 560px;
    padding: 24px;
    border-radius: 12px;
    background-color: rgba(28, 28, 32, 0.96);
    border-width: 1px;
    border-color: rgba(180, 140, 80, 0.4);
}

.inn-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.inn-title {
    color: rgb(220, 180, 100);
}

.inn-close-icon {
    --appui-iconbutton-size: 32px;
}

.inn-slot-count {
    color: rgb(180, 180, 180);
    margin-bottom: 8px;
    -unity-font-style: italic;
}

/* ========== 방문자 메인 ========== */

.inn-visitor-list {
    flex-direction: column;
    padding-top: 12px;
    padding-bottom: 12px;
    min-height: 220px;
}

.inn-visitor-card {
    flex-direction: row;
    align-items: flex-start;
    padding: 12px;
    margin-bottom: 8px;
    border-radius: 8px;
    background-color: rgba(40, 40, 48, 0.85);
    border-width: 1px;
    border-color: rgba(120, 100, 70, 0.35);
}

.inn-visitor-card-empty {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 16px;
    margin-bottom: 8px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(80, 80, 80, 0.35);
    background-color: rgba(20, 20, 22, 0.45);
}

.inn-visitor-empty-text {
    color: rgb(120, 120, 120);
    -unity-font-style: italic;
}

.inn-visitor-portrait {
    width: 56px;
    height: 56px;
    margin-right: 12px;
    border-radius: 6px;
    background-color: rgba(60, 60, 70, 0.6);
    border-width: 1px;
    border-color: rgba(150, 130, 80, 0.4);
}

.inn-visitor-info {
    flex-direction: column;
    flex-grow: 1;
}

.inn-visitor-name-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.inn-visitor-name {
    color: rgb(230, 220, 200);
    -unity-font-style: bold;
}

.inn-visitor-time {
    color: rgb(180, 180, 180);
}

.inn-visitor-time-warn {
    color: rgb(255, 180, 70);
}

.inn-visitor-time-urgent {
    color: rgb(255, 90, 90);
    -unity-font-style: bold;
}

.inn-visitor-meta {
    color: rgb(180, 180, 200);
    margin-bottom: 4px;
}

.inn-visitor-desc {
    color: rgb(150, 150, 165);
    margin-bottom: 8px;
    -unity-font-style: italic;
    white-space: normal;
}

.inn-visitor-action-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.inn-visitor-fail-text {
    color: rgb(220, 100, 100);
    margin-right: 8px;
}

.inn-visitor-hire-btn {
    min-width: 120px;
}

/* ========== 보조 영역 ========== */

.inn-aux {
    flex-direction: column;
    padding-top: 8px;
}

.inn-status {
    color: rgb(200, 200, 200);
    margin-bottom: 4px;
}

.inn-cost {
    color: rgb(255, 215, 100);
    margin-bottom: 8px;
}

.inn-aux-buttons {
    flex-direction: row;
    align-items: center;
}

.inn-aux-btn {
    margin-right: 8px;
}

.inn-aux-btn:disabled {
    opacity: 0.4;
}
