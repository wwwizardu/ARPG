/* Shrine UI 스타일 — Inn과 톤 일관 */

.shrine-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.shrine-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
}

.shrine-panel {
    width: 560px;
    padding: 24px;
    border-radius: 12px;
    background-color: rgba(28, 28, 32, 0.96);
    border-width: 1px;
    border-color: rgba(180, 140, 80, 0.4);
}

.shrine-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.shrine-title {
    color: rgb(220, 180, 100);
}

.shrine-close-icon {
    --appui-iconbutton-size: 32px;
}

.shrine-body {
    flex-direction: column;
    padding-top: 16px;
    padding-bottom: 16px;
}

.shrine-status {
    margin-bottom: 8px;
    color: rgb(220, 220, 220);
}

.shrine-cooldown {
    color: rgb(160, 200, 240);
}

.shrine-buffs {
    flex-direction: column;
    padding-top: 16px;
}

.shrine-buff-card {
    flex-direction: column;
    padding: 12px;
    margin-bottom: 8px;
    border-radius: 8px;
    background-color: rgba(50, 50, 60, 0.6);
    border-width: 1px;
    border-color: rgba(100, 100, 120, 0.3);
}

.shrine-buff-name {
    color: rgb(255, 215, 100);
    margin-bottom: 4px;
}

.shrine-buff-desc {
    color: rgb(200, 200, 200);
    margin-bottom: 8px;
    font-size: 12px;
}

.shrine-buff-btn {
}

.shrine-buff-btn:disabled {
    opacity: 0.4;
}
