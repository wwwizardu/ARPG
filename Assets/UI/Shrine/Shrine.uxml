<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:appui="Unity.AppUI.UI"
         editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Shrine/Shrine.uss"/>
    <ui:VisualElement name="root" class="shrine-root" picking-mode="Position">
        <ui:VisualElement name="overlay" class="shrine-overlay" picking-mode="Position"/>
        <ui:VisualElement name="panel" class="shrine-panel">
            <ui:VisualElement class="shrine-header">
                <appui:Heading text="제단" size="L" class="shrine-title"/>
                <appui:IconButton name="close-btn" icon="x" class="shrine-close-icon"/>
            </ui:VisualElement>

            <appui:Divider/>

            <ui:VisualElement class="shrine-body">
                <appui:Text name="status-text" text="가호 받기 가능" class="shrine-status"/>
                <appui:Text name="cooldown-text" text="지속시간: 30분 / 쿨다운: 12h" class="shrine-cooldown"/>
            </ui:VisualElement>

            <appui:Divider/>

            <ui:VisualElement class="shrine-buffs">
                <ui:VisualElement class="shrine-buff-card">
                    <appui:Text text="가호의 빛" class="shrine-buff-name"/>
                    <appui:Text text="받는 데미지 -10%" class="shrine-buff-desc"/>
                    <appui:Button name="buff1-btn" title="가호 받기" variant="Accent" size="M" class="shrine-buff-btn"/>
                </ui:VisualElement>

                <ui:VisualElement class="shrine-buff-card">
                    <appui:Text text="사냥꾼의 정확" class="shrine-buff-name"/>
                    <appui:Text text="치명타 +10%" class="shrine-buff-desc"/>
                    <appui:Button name="buff2-btn" title="가호 받기" variant="Accent" size="M" class="shrine-buff-btn"/>
                </ui:VisualElement>

                <ui:VisualElement class="shrine-buff-card">
                    <appui:Text text="헤르메스의 발" class="shrine-buff-name"/>
                    <appui:Text text="이속 +20%" class="shrine-buff-desc"/>
                    <appui:Button name="buff3-btn" title="가호 받기" variant="Accent" size="M" class="shrine-buff-btn"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
