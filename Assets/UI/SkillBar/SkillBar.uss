/* Skill HUD. UISkillBar binds equipped books and per-slot ECS state. */
.skillbar-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 28px;
    -unity-font: url("project://database/Assets/Art/Font/FontSource/BMJUA_ttf.ttf");
    color: rgb(224, 220, 212);
}

.skillbar-hud {
    transform-origin: 50% 100%;
    flex-direction: column;
    align-items: stretch;
}

/* 경험치 바 (PLAYER_LEVEL_CHARM_DESIGN §8.1) */
.skillbar-exp-row {
    flex-direction: row;
    align-items: center;
    height: 18px;
    margin-bottom: 4px;
}

.skillbar-exp-level {
    margin: 0 6px 0 0;
    padding: 0;
    font-size: 13px;
    color: rgb(255, 215, 130);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.skillbar-exp-bar {
    flex-grow: 1;
    height: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(180, 140, 80, 0.55);
    background-color: rgba(28, 28, 32, 0.94);
    overflow: hidden;
}

.skillbar-exp-bar:hover {
    border-color: rgba(255, 215, 130, 0.9);
}

.skillbar-exp-fill {
    width: 0;
    height: 100%;
    background-color: rgb(120, 190, 255);
}

.skillbar-exp-points {
    display: none;
    margin: 0 0 0 8px;
    padding: 0;
    font-size: 13px;
    color: rgb(120, 220, 120);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.skillbar-exp-points-visible {
    display: flex;
}

.skillbar-panel {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: rgba(28, 28, 32, 0.94);
    border-width: 1px;
    border-color: rgba(180, 140, 80, 0.55);
}

.skillbar-group {
    flex-direction: row;
    align-items: center;
}

.skillbar-separator {
    width: 1px;
    height: 64px;
    margin-left: 10px;
    margin-right: 10px;
    background-color: rgba(180, 140, 80, 0.35);
}

.skillbar-slot {
    position: relative;
    width: 72px;
    height: 92px;
    flex-shrink: 0;
    margin-left: 3px;
    margin-right: 3px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(128, 116, 96, 0.55);
    background-color: rgba(50, 50, 58, 0.85);
    align-items: center;
}

.skillbar-slot:hover {
    border-color: rgba(255, 215, 130, 0.9);
}

.skillbar-key {
    position: absolute;
    left: 6px;
    top: 3px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: rgb(220, 180, 100);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.skillbar-icon {
    position: absolute;
    left: 9px;
    right: 9px;
    top: 22px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.skillbar-empty-mark {
    position: absolute;
    width: 18px;
    height: 1px;
    top: 45px;
    background-color: rgba(154, 149, 138, 0.5);
    display: none;
}

.skillbar-name {
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 5px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.skillbar-cooldown-overlay {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 21px;
    height: 50px;
    overflow: hidden;
    display: none;
    justify-content: center;
    align-items: center;
}

.skillbar-cooldown-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    background-color: rgba(8, 8, 14, 0.78);
}

.skillbar-cooldown-text {
    margin: 0;
    padding: 0;
    font-size: 20px;
    color: rgb(242, 237, 223);
    -unity-text-align: middle-center;
}

.skillbar-mana-indicator {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 42px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: rgb(242, 160, 151);
    background-color: rgba(20, 12, 16, 0.82);
    -unity-text-align: middle-center;
    display: none;
}

.skillbar-slot-empty {
    background-color: rgba(35, 35, 41, 0.7);
    border-color: rgba(108, 104, 98, 0.35);
}

.skillbar-slot-empty .skillbar-icon {
    display: none;
}

.skillbar-slot-empty .skillbar-empty-mark {
    display: flex;
}

.skillbar-slot-empty .skillbar-name {
    color: rgb(139, 135, 124);
}

.skillbar-slot-equipped {
    background-color: rgba(57, 49, 39, 0.85);
    border-color: rgba(180, 140, 80, 0.75);
}

.skillbar-slot-cooldown .skillbar-cooldown-overlay {
    display: flex;
}

.skillbar-slot-no-mana .skillbar-icon {
    opacity: 0.3;
}

.skillbar-slot-no-mana .skillbar-mana-indicator {
    display: flex;
}

.skillbar-slot-active {
    border-color: rgb(242, 203, 117);
    background-color: rgba(93, 73, 39, 0.9);
}

.skillbar-settings-button {
    width: 104px;
    height: 34px;
    flex-shrink: 0;
    margin-left: 14px;
    margin-right: 2px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(180, 140, 80, 0.55);
    background-color: rgba(57, 49, 39, 0.85);
    color: rgb(220, 180, 100);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.skillbar-settings-button:hover {
    background-color: rgba(89, 69, 40, 0.95);
    border-color: rgba(242, 203, 117, 0.9);
}

.skillbar-settings-button:active {
    background-color: rgba(116, 86, 44, 0.95);
}
#quickitem-hud { -unity-font: url("../../Art/Font/FontSource/BMJUA_ttf.ttf"); }
