<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:appui="Unity.AppUI.UI"
         editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Shop/Shop.uss"/>
    <ui:VisualElement name="root" class="shop-root" picking-mode="Position">
        <ui:VisualElement name="overlay" class="shop-overlay" picking-mode="Position"/>
        <ui:VisualElement name="panel" class="shop-panel">
            <ui:VisualElement class="shop-header">
                <appui:Heading text="상점" size="L" class="shop-title"/>
                <appui:IconButton name="close-btn" icon="x" class="shop-close-icon"/>
            </ui:VisualElement>

            <appui:Divider/>

            <ui:VisualElement class="shop-info">
                <appui:Text name="gold-text" text="골드: 0 G" class="shop-gold"/>
            </ui:VisualElement>

            <appui:Divider/>

            <ui:VisualElement class="shop-tabs">
                <appui:Button name="buy-tab-btn" title="구매" variant="Accent" size="M" class="shop-tab-btn"/>
                <appui:Button name="sell-tab-btn" title="판매" variant="Default" size="M" class="shop-tab-btn"/>
            </ui:VisualElement>

            <appui:Divider/>

            <!-- 구매 패널 -->
            <ui:VisualElement name="buy-panel" class="shop-tab-panel">
                <appui:Text text="매물 목록" class="shop-section-title"/>
                <ui:ScrollView class="shop-buy-scroll">
                    <ui:VisualElement name="buy-list" class="shop-buy-list"/>
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- 판매 패널 -->
            <ui:VisualElement name="sell-panel" class="shop-tab-panel" style="display: none;">
                <appui:Text text="인벤토리 (매각 가능)" class="shop-section-title"/>
                <ui:VisualElement name="sell-grid" class="shop-sell-grid"/>
                <appui:Text name="selected-sell-text" text="매각할 아이템을 선택하세요" class="shop-selected"/>
                <appui:Button name="sell-action-btn" title="매각" variant="Accent" size="M" class="shop-sell-action-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
