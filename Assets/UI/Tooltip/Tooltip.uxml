<ui:UXML xmlns:ui="UnityEngine.UIElements"
         editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Tooltip/Tooltip.uss"/>
    <!-- 글로벌 툴팁 패널 (AR.s.Tooltip).
         타입별 자식 컨테이너를 display 토글로 활성/비활성.
         새 데이터 타입 추가 시 content-* 컨테이너만 추가하면 됨. -->
    <ui:VisualElement name="root" class="tooltip-root" picking-mode="Ignore">
        <ui:VisualElement name="tooltip" class="tooltip-frame" picking-mode="Ignore">

            <!-- SkillBook -->
            <ui:VisualElement name="content-skillbook" class="tooltip-content" picking-mode="Ignore">
                <ui:Label name="sb-name" class="tooltip-name"/>
                <ui:Label name="sb-tier" class="tooltip-tier"/>
                <ui:VisualElement class="tooltip-divider"/>
                <ui:Label name="sb-skillname" class="tooltip-skillname"/>
                <ui:Label name="sb-desc" class="tooltip-desc"/>
                <ui:VisualElement class="tooltip-stats">
                    <ui:Label name="sb-stat-damage" class="tooltip-statline"/>
                    <ui:Label name="sb-stat-cooltime" class="tooltip-statline"/>
                    <ui:Label name="sb-stat-mana" class="tooltip-statline"/>
                    <ui:Label name="sb-stat-range" class="tooltip-statline"/>
                </ui:VisualElement>
                <ui:VisualElement name="sb-page-section" class="tooltip-stats">
                    <ui:Label name="sb-page-capacity" class="tooltip-statline"/>
                    <ui:Label name="sb-page-list" class="tooltip-statline"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- SkillPage (SKILL_RUNE_DESIGN §7.3) -->
            <ui:VisualElement name="content-skillpage" class="tooltip-content" picking-mode="Ignore">
                <ui:Label name="sp-name" class="tooltip-name"/>
                <ui:Label name="sp-tier" class="tooltip-tier"/>
                <ui:VisualElement class="tooltip-divider"/>
                <ui:Label name="sp-effect-name" class="tooltip-skillname"/>
                <ui:Label name="sp-desc" class="tooltip-desc"/>
                <ui:VisualElement class="tooltip-stats">
                    <ui:Label name="sp-trigger" class="tooltip-statline"/>
                    <ui:Label name="sp-cost" class="tooltip-statline"/>
                    <ui:Label name="sp-efficiency" class="tooltip-statline"/>
                    <ui:Label name="sp-condition" class="tooltip-statline"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Equipment: 무기/방어구 베이스 스탯 + Implicit + Prefix/Postfix Mod -->
            <ui:VisualElement name="content-equipment" class="tooltip-content" picking-mode="Ignore">
                <ui:Label name="eq-name" class="tooltip-name"/>
                <ui:Label name="eq-tier" class="tooltip-tier"/>
                <ui:Label name="eq-item-level" class="tooltip-tier"/>
                <ui:VisualElement class="tooltip-divider"/>
                <!-- Base: 무기는 WeaponStats, 방어구는 Base Mod -->
                <ui:VisualElement name="eq-base-section" class="tooltip-section">
                    <ui:Label name="eq-base-title" text="기본 능력" class="tooltip-section-title"/>
                    <ui:VisualElement class="tooltip-stats">
                        <ui:Label name="eq-dmg-physics" class="tooltip-statline"/>
                        <ui:Label name="eq-dmg-fire" class="tooltip-statline"/>
                        <ui:Label name="eq-dmg-ice" class="tooltip-statline"/>
                        <ui:Label name="eq-dmg-lightning" class="tooltip-statline"/>
                        <ui:Label name="eq-dmg-poison" class="tooltip-statline"/>
                        <ui:Label name="eq-crit" class="tooltip-statline"/>
                        <ui:Label name="eq-as" class="tooltip-statline"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="eq-base-mods" class="tooltip-stats"/>
                </ui:VisualElement>
                <!-- 무기 인스턴스 고유 강화 -->
                <ui:VisualElement name="eq-enhancement-section" class="tooltip-section">
                    <ui:Label text="무기 고유 강화" class="tooltip-section-title tooltip-section-title-enhancement"/>
                    <ui:VisualElement name="eq-local-enhancements" class="tooltip-stats"/>
                </ui:VisualElement>
                <!-- 일반 글로벌 장비 옵션 -->
                <ui:VisualElement name="eq-options-section" class="tooltip-section">
                    <ui:Label text="장비 옵션" class="tooltip-section-title"/>
                    <ui:VisualElement name="eq-implicit-mods" class="tooltip-stats"/>
                    <ui:VisualElement name="eq-affix-mods" class="tooltip-stats"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 일반 아이템: 이름 + Tier + 설명 -->
            <ui:VisualElement name="content-item" class="tooltip-content" picking-mode="Ignore">
                <ui:Label name="it-name" class="tooltip-name"/>
                <ui:Label name="it-tier" class="tooltip-tier"/>
                <ui:VisualElement class="tooltip-divider"/>
                <ui:Label name="it-desc" class="tooltip-desc"/>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
