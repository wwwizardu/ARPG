/* 공용 확인 창 — SkillBook/Shop 톤 */
.confirm-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.confirm-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
}

.confirm-panel {
    width: 420px;
    padding: 24px;
    border-radius: 12px;
    background-color: rgba(28, 28, 32, 0.97);
    border-width: 1px;
    border-color: rgba(180, 140, 80, 0.55);
}

.confirm-message {
    white-space: normal;
    font-size: 16px;
    color: rgb(230, 225, 215);
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.confirm-buttons {
    flex-direction: row;
    justify-content: center;
}

.confirm-button {
    min-width: 120px;
    margin-left: 8px;
    margin-right: 8px;
}
