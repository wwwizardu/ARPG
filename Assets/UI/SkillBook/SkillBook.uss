/* SkillBook UI 스타일 — Shop/Inn/Shrine과 톤 일관 */

.skillbook-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.skillbook-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
}

.skillbook-panel {
    width: 880px;
    max-height: 90%;
    padding: 24px;
    border-radius: 12px;
    background-color: rgba(28, 28, 32, 0.96);
    border-width: 1px;
    border-color: rgba(180, 140, 80, 0.4);
}

.skillbook-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.skillbook-title {
    color: rgb(220, 180, 100);
}

.skillbook-close-icon {
    --appui-iconbutton-size: 32px;
}

.skillbook-body {
    flex-direction: row;
    padding-top: 12px;
    padding-bottom: 12px;
}

/* 좌측 인벤토리 패널 */
.skillbook-inventory-panel {
    width: 360px;
    flex-direction: column;
    margin-right: 24px;
}

.skillbook-section-title {
    color: rgb(200, 200, 200);
    margin-bottom: 8px;
    font-size: 12px;
}

.skillbook-inventory-scroll {
    height: 360px;
}

.skillbook-inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* 우측 슬롯 패널 */
.skillbook-slot-panel {
    flex-grow: 1;
    flex-direction: column;
}

.skillbook-slot-grid {
    flex-direction: column;
    margin-bottom: 8px;
}

.skillbook-slot-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.skillbook-slot {
    width: 76px;
    height: 76px;
    margin: 4px;
    border-radius: 6px;
    background-color: rgba(50, 50, 60, 0.6);
    border-width: 2px;
    border-color: rgba(100, 100, 120, 0.4);
    align-items: center;
    justify-content: center;
}

.skillbook-slot:hover {
    border-color: rgba(255, 215, 100, 0.6);
}

.skillbook-slot-equipped {
    border-color: rgba(180, 140, 80, 0.7);
    background-color: rgba(60, 50, 40, 0.7);
}

.skillbook-slot-icon {
    width: 56px;
    height: 56px;
    -unity-background-scale-mode: scale-to-fit;
}

.skillbook-slot-keylabel {
    position: absolute;
    top: 2px;
    left: 4px;
    color: rgb(255, 215, 100);
    font-size: 10px;
    -unity-font-style: bold;
}

.skillbook-slot-skillname {
    position: absolute;
    bottom: 2px;
    left: 0;
    right: 0;
    color: rgb(220, 220, 220);
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 인벤토리 책 슬롯 */
.skillbook-inv-item {
    width: 64px;
    height: 64px;
    margin: 4px;
    border-radius: 6px;
    background-color: rgba(50, 50, 60, 0.6);
    border-width: 2px;
    border-color: rgba(100, 100, 120, 0.4);
    align-items: center;
    justify-content: center;
}

.skillbook-inv-item:hover {
    border-color: rgba(255, 215, 100, 0.6);
}

.skillbook-inv-item-icon {
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.skillbook-inv-item-tier {
    position: absolute;
    top: 2px;
    left: 4px;
    color: rgb(180, 140, 80);
    font-size: 9px;
    -unity-font-style: bold;
}

/* 푸터 — 상태 메시지 */
.skillbook-footer {
    flex-direction: row;
    justify-content: center;
    padding-top: 8px;
}

.skillbook-status {
    color: rgb(255, 215, 100);
    font-size: 12px;
}

.skillbook-hint {
    color: rgb(140, 140, 140);
    font-size: 11px;
    margin-top: 12px;
    white-space: normal;
}

/* 빈 상태 */
.skillbook-empty-text {
    color: rgb(120, 120, 120);
    padding: 16px;
}

/* 드래그앤드롭 — 고스트(마우스 따라다니는 반투명 아이콘) */
.skillbook-drag-ghost {
    position: absolute;
    width: 64px;
    height: 64px;
    opacity: 0.75;
    -unity-background-scale-mode: scale-to-fit;
}

/* 드래그 중 마우스 아래의 장착 슬롯 강조 */
.skillbook-slot-droptarget {
    border-color: rgb(255, 215, 100);
    background-color: rgba(120, 90, 40, 0.7);
}
