<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xmlns:appui="Unity.AppUI.UI"
         editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Cheat/Cheat.uss"/>
    <ui:VisualElement name="root" class="cheat-root" picking-mode="Position">
        <ui:VisualElement name="overlay" class="cheat-overlay" picking-mode="Position"/>
        <ui:VisualElement name="panel" class="cheat-panel">
            <ui:VisualElement class="cheat-header">
                <appui:Heading text="치트" size="L" class="cheat-title"/>
                <appui:IconButton name="close-btn" icon="x" class="cheat-close-icon"/>
            </ui:VisualElement>

            <appui:Divider/>

            <ui:VisualElement class="cheat-row">
                <appui:Text text="아이템 ID" class="cheat-label"/>
                <ui:TextField name="item-input" class="cheat-input"/>
                <appui:Button name="add-item-btn" title="아이템 생성" variant="Accent" size="M" class="cheat-action-btn"/>
            </ui:VisualElement>

            <ui:VisualElement class="cheat-row">
                <appui:Text text="골드 수량" class="cheat-label"/>
                <ui:TextField name="gold-input" class="cheat-input"/>
                <appui:Button name="add-gold-btn" title="골드 추가" variant="Accent" size="M" class="cheat-action-btn"/>
            </ui:VisualElement>

            <ui:VisualElement class="cheat-row">
                <appui:Text text="스킬 ID" class="cheat-label"/>
                <ui:TextField name="skill-input" class="cheat-input"/>
                <appui:Button name="add-skillbook-btn" title="스킬북 생성" variant="Accent" size="M" class="cheat-action-btn"/>
            </ui:VisualElement>

            <appui:Divider/>

            <appui:Text name="popup-text" text="" class="cheat-popup"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
