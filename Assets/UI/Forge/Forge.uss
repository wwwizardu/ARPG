.forge-root {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.forge-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.68);
}

.forge-panel {
    width: 980px;
    max-height: 900px;
    padding: 22px;
    border-radius: 12px;
    background-color: rgba(28, 28, 32, 0.98);
    border-width: 1px;
    border-color: rgba(180, 140, 80, 0.5);
}

.forge-header,
.forge-tier-row,
.forge-actions,
.forge-columns,
.forge-result-columns {
    flex-direction: row;
}

.forge-header {
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.forge-title,
.forge-result-title {
    color: rgb(230, 185, 95);
}

.forge-close-icon {
    --appui-iconbutton-size: 32px;
}

.forge-tier-row {
    justify-content: space-between;
    padding-top: 10px;
    padding-bottom: 10px;
}

.forge-tier {
    color: rgb(225, 225, 225);
}

.forge-tier-note {
    color: rgb(170, 210, 150);
    font-size: 12px;
}

.forge-columns {
    height: 430px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.forge-column {
    width: 50%;
    min-width: 0;
    padding-left: 10px;
    padding-right: 10px;
}

.forge-column-left {
    border-right-width: 1px;
    border-right-color: rgba(130, 130, 145, 0.35);
}

.forge-section-title,
.forge-subtitle {
    color: rgb(205, 205, 210);
    margin-bottom: 8px;
    font-size: 13px;
}

.forge-subtitle {
    margin-top: 8px;
    font-size: 12px;
}

.forge-scroll {
    border-width: 1px;
    border-color: rgba(105, 105, 120, 0.45);
    border-radius: 6px;
    background-color: rgba(18, 18, 22, 0.45);
}

.forge-equipment-scroll {
    height: 235px;
}

.forge-options-scroll {
    height: 105px;
    border-width: 1px;
    border-color: rgba(90, 90, 105, 0.35);
    border-radius: 5px;
}

.forge-inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 5px;
}

.forge-inv-slot {
    width: 56px;
    height: 56px;
    margin: 4px;
    border-radius: 6px;
    background-color: rgba(50, 50, 60, 0.6);
    border-width: 2px;
    border-color: rgba(100, 100, 120, 0.4);
    align-items: center;
    justify-content: center;
}

.forge-inv-slot:hover {
    border-color: rgba(255, 215, 100, 0.65);
}

.forge-inv-slot-equipment {
    border-color: rgba(180, 140, 80, 0.6);
    background-color: rgba(60, 50, 40, 0.72);
}

.forge-inv-slot-disabled {
    opacity: 0.25;
}

.forge-inv-slot-selected {
    border-color: rgb(255, 215, 100);
    background-color: rgba(100, 80, 40, 0.85);
}

.forge-inv-icon {
    width: 44px;
    height: 44px;
    -unity-background-scale-mode: scale-to-fit;
}

.forge-inv-empty-text,
.forge-list-empty {
    color: rgb(135, 135, 140);
    font-size: 11px;
    margin: 8px;
}

.forge-selected {
    color: rgb(255, 215, 100);
    margin-top: 7px;
}

/* 작업 카드 4개(품질·진화·변화·엑잘티드)가 칸 높이를 넘으면 스크롤한다 */
.forge-operation-scroll {
    flex-grow: 1;
}

.forge-operation-card {
    margin-bottom: 12px;
    padding: 12px;
    border-width: 1px;
    border-color: rgba(125, 125, 140, 0.5);
    border-radius: 6px;
    background-color: rgba(48, 48, 58, 0.7);
}

.forge-card-title {
    color: rgb(225, 225, 230);
    font-size: 12px;
}

.forge-card-detail {
    color: rgb(165, 165, 175);
    font-size: 11px;
    margin-top: 4px;
}

.forge-cost {
    color: rgb(240, 200, 105);
    margin-top: 6px;
    font-size: 12px;
}

.forge-status {
    color: rgb(220, 135, 120);
    margin-top: 5px;
    font-size: 11px;
}

.forge-option-list {
    padding: 6px;
}

.forge-option-line {
    color: rgb(190, 190, 200);
    font-size: 11px;
    margin-bottom: 3px;
}

.forge-actions {
    justify-content: flex-end;
    padding-top: 12px;
}

.forge-secondary-btn {
    width: 190px;
    margin-right: 8px;
}

.forge-operation-btn {
    width: 100%;
    margin-top: 10px;
}

.forge-secondary-btn:disabled,
.forge-operation-btn:disabled {
    opacity: 0.4;
}

.forge-result-section {
    padding-top: 12px;
}

.forge-result-title {
    margin-top: 10px;
    margin-bottom: 8px;
}

.forge-result-column {
    width: 50%;
    padding-left: 8px;
    padding-right: 8px;
}

.forge-result-scroll {
    height: 135px;
    border-width: 1px;
    border-color: rgba(105, 105, 120, 0.4);
    border-radius: 5px;
}

.forge-hidden {
    display: none;
}
