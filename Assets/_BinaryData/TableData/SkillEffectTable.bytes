[{"Name":"LifeSteal_15%","Description":"적중 시 입힌 피해의 15%만큼 생명력을 회복한다.","Tier":1,"EffectType":"LifeSteal","Kind":"StatBonus","Trigger":"OnHit","Param1":15.0,"Param2":0.0,"Param3":0.0,"Probability":100,"PageCost":7,"Condition":"None","ConditionParam":0.0,"Id":1001},{"Name":"OnHit_Bleed","Description":"적중 시 대상에게 출혈 디버프를 부여한다.","Tier":1,"EffectType":"ApplyBuff","Kind":"EffectAction","Trigger":"OnHit","Param1":1.0,"Param2":0.0,"Param3":0.0,"Probability":100,"PageCost":4,"Condition":"None","ConditionParam":0.0,"Id":1002},{"Name":"Delegate_Totem_8s","Description":"스킬 발동 시 8초 동안 토템을 소환하여 대신 시전하게 한다.","Tier":1,"EffectType":"DelegateToTotem","Kind":"EffectAction","Trigger":"OnSkillCommand","Param1":8.0,"Param2":0.0,"Param3":0.0,"Probability":100,"PageCost":9,"Condition":"None","ConditionParam":0.0,"Id":1010},{"Name":"MultiShot_3","Description":"스킬 시전 시 투사체 3개를 부채꼴로 발사한다.","Tier":1,"EffectType":"ProjectileCountAdd","Kind":"StatBonus","Trigger":"OnSkillStart","Param1":2.0,"Param2":0.0,"Param3":0.0,"Probability":100,"PageCost":9,"Condition":"None","ConditionParam":0.0,"Id":2003},{"Name":"ChainLightningPropagation","Description":"스킬 커밋 위치에서 가장 가까운 적에게 연쇄 번개 전달을 시작한다.","Tier":0,"EffectType":"SkillPropagation","Kind":"EffectAction","Trigger":"OnSkillCommit","Param1":1.0,"Param2":0.0,"Param3":0.0,"Probability":100,"PageCost":0,"Condition":"None","ConditionParam":0.0,"Id":1020},{"Name":"Knockback_Short","Description":"적중한 대상을 판정 범위 중심에서 바깥으로 1칸 밀어낸다.","Tier":0,"EffectType":"Knockback","Kind":"EffectAction","Trigger":"OnHit","Param1":1.0,"Param2":0.15,"Param3":0.0,"Probability":100,"PageCost":0,"Condition":"None","ConditionParam":0.0,"Id":1030},{"Name":"Pull_Short","Description":"적중한 대상을 판정 범위 중심 쪽으로 최대 1칸 끌어당긴다. 중심을 넘지 않는다.","Tier":0,"EffectType":"Pull","Kind":"EffectAction","Trigger":"OnHit","Param1":1.0,"Param2":0.15,"Param3":0.0,"Probability":100,"PageCost":0,"Condition":"None","ConditionParam":0.0,"Id":1031},{"Name":"Knockback_Charge","Description":"돌진에 부딪힌 대상을 돌진 경로 옆으로 2칸 밀쳐 낸다.","Tier":0,"EffectType":"Knockback","Kind":"EffectAction","Trigger":"OnHit","Param1":2.0,"Param2":0.2,"Param3":0.0,"Probability":100,"PageCost":0,"Condition":"None","ConditionParam":0.0,"Id":1032},{"Name":"Summon_FireImp_2","Description":"시전자 둘레에 화염임프를 부른다. 같은 효과로 부른 임프가 2마리보다 적으면 모자란 만큼 부르고, 임프는 12초 뒤 사라진다. 몬스터 전용.","Tier":0,"EffectType":"SummonMonster","Kind":"EffectAction","Trigger":"OnSkillCommit","Param1":1005.0,"Param2":2.0,"Param3":12.0,"Probability":100,"PageCost":0,"Condition":"None","ConditionParam":0.0,"Id":1040}]